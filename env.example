# Нужен только для запуска на своём компьютере. На GitHub используются секреты.
# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...
# Канал: @username или числовой id (-100...). Бот должен быть админом канала.
CHANNEL_ID=@my_news_channel

# Необязательно:
POSTS_PER_RUN=1
MAX_AGE_HOURS=48
MAX_CHARS=350
# 1 = пробный режим: показать пост в логе, ничего не отправлять
DRY_RUN=0
